# Configurazione del tuo progetto Firebase (Web App).
# Copia questo file in `.env` e inserisci i valori reali.
# Li trovi su Firebase Console > Impostazioni progetto > Le tue app > Web app.
# La apiKey è pubblica per design (l'accesso è protetto dalle Firestore Rules).
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=il-tuo-progetto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=il-tuo-progetto
VITE_FIREBASE_STORAGE_BUCKET=il-tuo-progetto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# Chiave reCAPTCHA v3 per App Check (captcha invisibile sugli ordini).
# Console reCAPTCHA: https://www.google.com/recaptcha/admin → v3 → site key,
# poi registrala in Firebase Console → App Check.
VITE_RECAPTCHA_SITE_KEY=6L...

# Chiave pubblica VAPID per le notifiche push FCM (Web Push).
# Firebase Console > Impostazioni progetto > Cloud Messaging > Web Push certificates.
VITE_FIREBASE_VAPID_KEY=B...

# --- Emulatore Firebase (sviluppo/testing, es. con Docker) ---
# Imposta a "true" per collegare il client agli emulatori Firestore + Functions
# invece che al progetto reale. Con Docker viene già impostato in docker-compose.yml.
# In questa modalità basta un projectId "demo-*" (nessuna credenziale reale).
# VITE_USE_FIREBASE_EMULATOR=true
# VITE_FIRESTORE_EMULATOR_HOST=localhost
# VITE_FIRESTORE_EMULATOR_PORT=8080
