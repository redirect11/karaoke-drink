{
  "name": "karaoke-drink",
  "private": true,
  "version": "1.5.8",
  "type": "module",
  "description": "App per la prenotazione dei drink del cocktail bar La Tana del Coniglio",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:regole": "vitest run --config vitest.regole.config.mjs",
    "test:coverage": "vitest run --coverage",
    "requirements:issues": "node scripts/generate-issues.mjs",
    "seed": "node scripts/seed.js",
    "seed:dev": "node scripts/seed.js --dev",
    "mock:orders": "node scripts/mock-orders.js",
    "mock:history": "node scripts/mock-history.js",
    "mock:casse": "node scripts/mock-casse.js",
    "seed:vecchi": "node scripts/seed-magazzino-vecchio.js",
    "seed:tutto": "npm run seed:dev && npm run mock:history && npm run mock:casse",
    "emulators": "firebase emulators:start --project demo-tana-drink --only auth,firestore,storage --import=.emulatori --export-on-exit",
    "emulatori": "firebase emulators:start --project demo-tana-drink --only auth,firestore,storage,functions,hosting --import=.emulatori --export-on-exit",
    "locale": "vite build --mode locale && npm run emulatori"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^12.14.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "firebase-admin": "^13.10.0",
    "globals": "^15.9.0",
    "happy-dom": "^20.10.6",
    "vite": "^5.4.8",
    "vitest": "^2.1.8"
  }
}
