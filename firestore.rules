rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Ruoli ─────────────────────────────────────────────────────────
    // Il ruolo vive nei custom claims del token ("role"): 'admin',
    // 'bartender' o 'staff', assegnati esplicitamente dall'admin. Gli
    // account SENZA claim sono CLIENTI registrati (nessun privilegio
    // gestionale). Lo staff può SOLO segnare come serviti gli ordini pronti.
    //
    // isBartender() vale anche per l'admin: le due figure hanno lo stesso
    // accesso ai dati, l'admin in più nomina i ruoli — e quello non passa
    // da qui, ma dalla callable staffAdmin (Admin SDK).
    function isSignedIn() {
      return request.auth != null;
    }
    function isBartender() {
      return isSignedIn()
        && 'role' in request.auth.token
        && request.auth.token.role in ['admin', 'bartender'];
    }
    function isStaffMember() {
      return isSignedIn()
        && 'role' in request.auth.token
        && request.auth.token.role in ['admin', 'bartender', 'staff'];
    }
    // LA SALA: chi porta i drink al tavolo. Serve, non prepara — e quello
    // che non può fare va scritto anche qui, non solo nell'interfaccia.
    function isSala() {
      return isSignedIn()
        && 'role' in request.auth.token
        && request.auth.token.role == 'staff';
    }

    // DRINKS — lettura pubblica (clienti vedono il menù), scrittura solo bartender.
    match /drinks/{drinkId} {
      allow read: if true;
      allow write: if isBartender();
    }

    // ORDERS — i clienti creano e leggono; il bartender aggiorna qualsiasi
    // cosa; lo staff può solo portare un ordine da "pronto" a
    // "ritirato" (servizio al tavolo). Il cliente (non autenticato, in
    // possesso dell'id ordine) può modificare o annullare l'ordine SOLO
    // finché è "ricevuto": può lasciarlo "ricevuto" (modifica item) o
    // portarlo ad "annullato". Non può farlo avanzare di stato.
    match /orders/{orderId} {
      // Campi di pagamento: scritti da Cloud Functions (Admin SDK) e da
      // bartender/staff — mai dal cliente anonimo, che altrimenti
      // potrebbe auto-marcarsi "pagato".
      function paymentKeys() {
        return ['payment_status', 'payment_method', 'payment_required',
                'paid_at', 'sumup_checkout_id', 'sumup_checkout_attempts',
                'sumup_transaction_id', 'sumup_client_transaction_id',
                'payment_after_cancel', 'payment_id',
                'payments', 'discount', 'discount_amount',
                'sumup_pending_amount', 'sumup_pending_items',
                'invoice_id', 'invoice_number'];
      }
      // CHI NON È DEL PERSONALE NON FIRMA COL NOME DEL PERSONALE, e non
      // apre un conto che è già successo qualcosa. Prima la creazione era
      // un rubinetto aperto: bastava l'apiKey del bundle per far comparire
      // in coda un conto intestato all'email dell'admin, o già pagato, o
      // già fatturato. Il personale continua a fare quello che vuole:
      // questi vincoli valgono solo per chi non è autenticato col ruolo.
      //
      // Quello che il cliente scrive davvero passando dal menù sta in
      // src/lib/api.js (creaOrdine): un conto `aperto`, con UNA comanda,
      // `placed_by` nullo, nessun campo di pagamento già valorizzato.
      // Questi vincoli sono la stessa cosa, detta dal lato del server.
      function conteNuovoDaCliente() {
        let d = request.resource.data;
        return
          // Mai già pagato (era l'unico controllo che c'era).
          (!('payment_status' in d)
            || d.payment_status in ['non_richiesto', 'in_attesa'])
          // Mai firmato da qualcuno del personale.
          && d.get('placed_by', null) == null
          // Mai già incassato, scontato, fatturato o venduto a SumUp.
          && !d.keys().hasAny(['paid_at', 'payment_id', 'payments',
                               'discount', 'discount_amount',
                               'invoice_id', 'invoice_number',
                               'sumup_sale_id', 'sumup_checkout_id',
                               'sumup_transaction_id',
                               'closed_in_session'])
          // Mai intestato all'account di un ALTRO cliente: quello
          // finirebbe nei «miei ordini» e nel gruppo di chi non c'entra.
          && (d.get('customer_uid', null) == null
              || (isSignedIn() && d.customer_uid == request.auth.uid))
          // Un conto nasce aperto, con una comanda sola e un totale che è
          // un numero non negativo.
          && d.get('status', '') == 'aperto'
          && d.get('comande', []).size() == 1
          && d.get('total', 0) is number
          && d.get('total', 0) >= 0;
      }
      // GET E LIST SONO DUE COSE DIVERSE, e per questo stanno su due righe.
      // Chi un domani vorrà «semplificare» rimettendo un `allow read` unico
      // riapre BUG-093: `read` è la somma delle due, e quella che fa male è
      // la seconda.
      //
      //   · GET è leggere UN documento di cui si conosce l'id. È il modello
      //     voluto — l'id fa da lasciapassare, è casuale a 20 caratteri, e
      //     chi ha il link del proprio conto lo vede senza registrarsi.
      //     Resta aperto: chiuderlo vuol dire spegnere il menù del cliente.
      //   · LIST è scaricarne tanti insieme, ed era concesso per errore: la
      //     lettura non era ristretta, e con la sola chiave pubblica del
      //     bundle si arrivava ai dati dei clienti — mesi di nomi, note,
      //     importi, email di chi ha battuto i conti.
      //
      // Adesso una lista passa solo se la DOMANDA dimostra da sé di restare
      // dentro un recinto: le regole non filtrano i risultati, misurano la
      // query prima di eseguirla, e una lista senza filtri viene respinta
      // anche quando i documenti che tornerebbero sarebbero tutti leciti.
      //
      // I recinti sono i tre modi legittimi di chiedere una lista:
      //   · il PERSONALE, che per mestiere legge tutto (coda, storico,
      //     statistiche, cassa, gruppi);
      //   · il CLIENTE REGISTRATO sui conti intestati al suo account, che è
      //     come «i miei ordini» lo ritrova da un altro telefono;
      //   · il TABELLONE del menù: le due liste che dicono a chi aspetta
      //     quanta coda c'è e cosa è pronto al ritiro.
      //
      // Il cliente NON registrato non ha un recinto e non gli serve: «i miei
      // ordini» tiene gli id nel telefono e li chiede uno per uno, con dei
      // get (fetchOrdersByIds in src/lib/api.js). Era una query su
      // `documentId() in [...]`, che nessuna regola sa riconoscere; la strada
      // è cambiata nel client invece di allargare il permesso qui.
      //
      // RESTA FUORI, ed è il terzo passo di BUG-093: il tabellone e la coda
      // del banco tornano i documenti INTERI, e lì dentro ci sono ancora
      // push_token, customer_uid e placed_by. Le regole non sanno proiettare
      // campi: per non mostrarli vanno spostati, e quello tocca cinque punti
      // dell'app.
      allow get: if true;
      allow list: if isStaffMember()
        || (isSignedIn() && resource.data.customer_uid == request.auth.uid)
        || resource.data.comande_statuses.hasAny(['ricevuto', 'in_preparazione'])
        || resource.data.comande_statuses.hasAny(['pronto']);
      allow create: if isStaffMember() || conteNuovoDaCliente();
      // Modello conto/comande: il flusso di lavorazione vive sulle comande
      // (array nel doc), quindi le transizioni fini sono validate in app.
      // Il banco aggiorna qualunque cosa; il cliente anonimo solo finché il
      // conto ha la sola prima comanda ancora "ricevuta", senza toccare i
      // campi di pagamento, e può al più annullare.
      // LA SALA SERVE, NON PREPARA (REQ-STAFF-014). Lavora sugli ORDINI —
      // aggiunge righe a un conto, incassa al tavolo, segna «servito» —
      // ma non butta il lavoro del banco. Due cose il server le sa vedere
      // da sé, e sono quelle che qui si negano:
      //   · ANNULLARE il conto: è il lavoro di chi versa che si straccia;
      //   · far SPARIRE una comanda: le sue aggiunte ne fanno nascere una
      //     nuova, e il numero di comande non scende mai.
      // Il resto — prendere in carico, segnare pronto, tornare indietro,
      // dividere — è il confronto di due array elemento per elemento, e le
      // regole non hanno cicli. Resta validato in app (src/lib/ruoli.js),
      // come tutto il flusso fine delle comande. Una regola che rifiuta il
      // lavoro buono quando la cache del terminale è indietro di un battito
      // farebbe più danno del permesso che chiude: al banco vuol dire un
      // ordine che non parte.
      allow update: if isBartender()
        || (isSala()
            && request.resource.data.status != 'annullato'
            && request.resource.data.get('comande', []).size()
               >= resource.data.get('comande', []).size())
        || (resource.data.status in ['aperto', 'ricevuto']
            && (!('comande' in resource.data)
                || (resource.data.comande.size() == 1
                    && resource.data.comande[0].status == 'ricevuto'))
            && request.resource.data.status in ['aperto', 'ricevuto', 'annullato']
            && !request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(paymentKeys().toSet()));
      allow delete: if false;
    }

    // COUNTERS — i numeri dei conti, e il puntatore alla cassa aperta.
    //
    // Erano `write: if true`: chiunque avesse letto apiKey e projectId dal
    // bundle (sono pubblici per disegno) poteva scrivere `last: 0` e far
    // ripartire la numerazione da capo. La sera dopo, due conti #15 — uno
    // stampato e in mano al cliente, l'altro a schermo. È lo stesso guaio
    // che progressivi.js racconta di aver già vissuto per sbaglio, stavolta
    // fatto apposta.
    //
    // Chiudere agli anonimi non si poteva: il cliente che ordina dal menù
    // NON è autenticato, e il suo conto prende il numero dallo stesso
    // contatore del banco, senza aspettare il server (lib/progressivi.js).
    // Una regola che pretendesse il login gli spegnerebbe l'incremento —
    // il conto uscirebbe lo stesso, ma il contatore non salirebbe, e il
    // cliente dopo prenderebbe lo stesso numero. Il doppione, di nuovo.
    //
    // Quindi non si chiede CHI scrive, si chiede COSA scrive: a chi non è
    // del personale si concede esattamente il gesto che fa progressivi.js —
    // un `increment(1)` sul solo campo `last` — e nient'altro. Il numero
    // può solo salire, di uno per volta: azzerarlo, spararlo a 999999 o
    // infilare altri campi non passa più. Le regole vedono il valore DOPO
    // l'incremento, quindi il vincolo si può scrivere così com'è.
    //
    // Resta il gocciolamento: mille chiamate spingono il contatore avanti di
    // mille. Sono numeri alti, brutti da vedere, ma mai due conti con lo
    // stesso numero — che è il danno vero. A fermare anche quello è App
    // Check imposto (BUG-092), che è una decisione a parte.
    match /counters/{dateKey} {
      allow read: if true;
      // Il personale fa tutto: apre la cassa (_active_cash), numera le
      // fatture (fatture-AAAA), corregge, importa.
      allow write: if isStaffMember();
      allow create: if request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == 1;
      allow update: if request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['last'])
        && request.resource.data.last == resource.data.last + 1;
    }

    // SERVIZIO PERPETUO — niente più "serate". Statistiche tempi (ETA):
    // lettura pubblica (il cliente vede la stima), scrittura dello staff
    // limitata ai campi statistici.
    match /service_stats/{docId} {
      allow read: if true;
      allow create, delete: if isBartender();
      allow update: if isBartender()
        || (isStaffMember()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['eta_stats', 'prep_stats']));
    }

    // CATEGORIES — lettura pubblica (il menù raggruppa per categoria), scrittura bartender.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isBartender();
    }

    // SETTINGS — lettura pubblica (i clienti vedono la modalità menù, coperto…), scrittura bartender.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isBartender();
    }

    // INVENTORY — solo bartender (non serve al cliente né allo staff).
    match /inventory_items/{itemId} {
      allow read, write: if isBartender();
    }

    // CATEGORIE INVENTARIO — dedicate ai prodotti di magazzino, solo bartender.
    match /inventory_categories/{categoryId} {
      allow read, write: if isBartender();
    }

    // MACRO-CATEGORIE — raggruppano le categorie per i conti aggregati, solo bartender.
    match /macro_categories/{macroId} {
      allow read, write: if isBartender();
    }

    // FORNITORI — anagrafica fornitori di magazzino, solo bartender.
    match /suppliers/{supplierId} {
      allow read, write: if isBartender();
    }

    // LISTINO FORNITORI — il prezzo di un prodotto PRESSO un fornitore
    // (REQ-MAG-029). Sta con i fornitori: un prodotto, più listini.
    match /supplier_prices/{rigaId} {
      allow read, write: if isBartender();
    }

    // STORICO DEI PREZZI — una riga per ogni variazione di un prezzo di
    // listino, con la data e da dove viene (REQ-MAG-035). Stessa mano del
    // listino: chi può cambiare un prezzo può scriverne la variazione, e
    // chi legge il listino deve poter leggere com'è arrivato a quel numero.
    match /supplier_price_history/{variazioneId} {
      allow read, write: if isBartender();
    }

    // STOCK MOVEMENTS — registro carico/scarico, solo bartender.
    match /stock_movements/{movementId} {
      allow read, write: if isBartender();
    }

    // CONTE DI MAGAZZINO — inventario periodico (dep/acq/rim→consumo).
    match /stock_counts/{countId} {
      allow read, write: if isBartender();
    }

    // ORDINI FORNITORE — generatore ordini e storico acquisti.
    match /purchase_orders/{orderId} {
      allow read, write: if isBartender();
    }

    // MODELLI D'ORDINE — il giro che si rifà uguale (REQ-MAG-039): prodotti,
    // fornitore scelto e quantità, senza prezzi. Stessa mano degli ordini:
    // chi compone un ordine è chi salva e riusa un modello.
    match /purchase_order_templates/{modelloId} {
      allow read, write: if isBartender();
    }

    // SCADENZARIO FORNITORI — documenti/proforma, pagato, note.
    match /supplier_invoices/{invoiceId} {
      allow read, write: if isBartender();
    }

    // ALTRE SPESE — quello che esce dal conto e non entra in magazzino
    // (REQ-MAG-034): arredi, attrezzature, materiale di consumo. Stessa mano
    // delle altre collezioni dei fornitori: nell'app la sezione è del solo
    // admin (sezioni.js, ruoli.js), ma qui vale il permesso di chi registra i
    // soldi che escono — un documento contabile non può essere più aperto
    // della fattura che gli sta accanto.
    match /altre_spese/{spesaId} {
      allow read, write: if isBartender();
    }

    // STAFF CALLS — cerca-persone: il bartender chiama, lo staff risponde.
    match /staff_calls/{callId} {
      allow read: if isStaffMember();
      allow create, delete: if isBartender();
      allow update: if isStaffMember();
    }

    // STAFF_TOKENS — token push del dispositivo di ciascun membro dello
    // staff (per la chiamata cerca-persone): solo il proprietario.
    // TOKEN PUSH: una riga per DISPOSITIVO, non per persona (lo stesso
    // account su tablet e telefono si sovrascriveva la riga a vicenda, e
    // l'avviso arrivava solo all'ultimo che aveva aperto il gestionale).
    // L'identificativo del documento è quello del dispositivo, quindi non
    // può più essere l'uid a fare da lucchetto: chi scrive deve dichiararsi
    // dentro la riga (`uid`), e può toccare solo le proprie. Le righe
    // vecchie, intestate all'uid, restano raggiungibili da chi le ha fatte.
    match /staff_tokens/{docId} {
      allow read: if isStaffMember() &&
        (request.auth.uid == docId || resource.data.uid == request.auth.uid);
      allow create, update: if isStaffMember() &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if isStaffMember() &&
        (request.auth.uid == docId || resource.data.uid == request.auth.uid);
    }

    // CHI È COLLEGATO ADESSO: una riga per PERSONA, che il suo terminale
    // riscrive ogni tanto («ci sono»). Serve alla legenda della coda, dove
    // chi si collega compare fra le iniziali prima ancora di battere un
    // conto.
    //
    // SCRIVE SOLO SE STESSO, chiunque sia del personale: anche chi non può
    // LEGGERE l'elenco deve comparirci per gli altri — un cameriere non sa
    // chi c'è, ma gli altri sanno che c'è lui.
    //
    // LEGGE SOLO CHI MANDA AVANTI IL LOCALE (admin e bartender). Sapere chi
    // è collegato è un'informazione sulle persone, non sul lavoro: la sala
    // vede la legenda di chi ha battuto i conti, che si ricava dai conti
    // stessi, e il cliente non vede niente. Il lucchetto sta anche qui e non
    // solo nella schermata: un permesso che esiste solo nell'interfaccia non
    // è un permesso.
    match /presenze/{uid} {
      allow read: if isBartender();
      allow create, update: if isStaffMember() && request.auth.uid == uid;
      allow delete: if isBartender() || (isSignedIn() && request.auth.uid == uid);
    }

    // CUSTOMERS — profilo del cliente registrato: solo il proprietario
    // (e il bartender in lettura).
    match /customers/{uid} {
      allow read: if isBartender() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // GROUPS — contenitori di ordini. Lo staff gestisce tutto; il cliente
    // registrato può creare/aggiornare SOLO il proprio gruppo-cliente
    // (id == uid, kind 'customer', radice, senza sottogruppi).
    match /groups/{groupId} {
      allow read: if isStaffMember()
        || (isSignedIn() && resource.data.customer_uid == request.auth.uid);
      allow create: if isStaffMember()
        || (isSignedIn()
            && groupId == request.auth.uid
            && request.resource.data.kind == 'customer'
            && request.resource.data.customer_uid == request.auth.uid
            && request.resource.data.parent_group_id == null
            && request.resource.data.has_child_groups == false);
      allow update: if isBartender()
        || (isStaffMember()
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['kind', 'customer_uid'].toSet()))
        || (isSignedIn()
            && resource.data.kind == 'customer'
            && resource.data.customer_uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'status', 'last_order_at'].toSet()));
      allow delete: if isBartender();
    }

    // PAYMENTS — registro incassi (ledger). Scrivibile dallo staff e dalle
    // Cloud Functions (Admin SDK, per i pagamenti online). Mai dal cliente.
    // RAPP ORE: registro ore dello staff — solo staff autenticato.
    match /staff_hours/{entryId} {
      allow read, write: if isStaffMember();
    }

    // PREFERENZE POS (ordine card, preferiti): configurazione del banco,
    // gestita dallo staff. Condivisa fra i dispositivi del locale.
    match /pos_prefs/{docId} {
      allow read, write: if isStaffMember();
    }

    // PAGHE: tariffa oraria per persona (storicizzata). Dato sensibile:
    // solo il bartender, nemmeno lo staff vede quanto prendono gli altri.
    match /staff_rates/{personId} {
      allow read, write: if isBartender();
    }

    // BADGE VIRTUALE: timbrature entrata/uscita — lo staff timbra sé
    // stesso al login/logout; il bartender può correggere ogni voce.
    match /staff_shifts/{shiftId} {
      allow read: if isStaffMember();
      allow create, update: if isStaffMember();
      allow delete: if isBartender();
    }

    // BUONI VIP: credito ricaricabile — solo staff (contiene i nomi VIP).
    match /vouchers/{voucherId} {
      allow read, write: if isStaffMember();
    }

    // FATTURE di cortesia: solo staff (contengono dati dei clienti).
    match /invoices/{invoiceId} {
      allow read, write: if isStaffMember();
    }

    match /payments/{paymentId} {
      allow read: if isStaffMember();
      allow create, update: if isStaffMember();
      allow delete: if false;
    }

    // CASSA: sessioni di apertura/chiusura serata (flusso cassa). Staff.
    match /cash_sessions/{sessionId} {
      allow read: if isStaffMember();
      allow create, update: if isStaffMember();
      allow delete: if false;
    }
  }
}
